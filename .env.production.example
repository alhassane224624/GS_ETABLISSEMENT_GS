# =============================================================================
# Modèle de configuration pour le SERVEUR DE PRODUCTION
# Sur le serveur : cp .env.production.example .env  puis remplir les valeurs <...>
# Ne jamais commiter le fichier .env rempli (il contient les mots de passe).
# =============================================================================

APP_NAME="Gestion Établissement"
APP_ENV=production
APP_KEY=
# Ne jamais mettre true en production : afficherait le code et les mots de passe en cas d'erreur
APP_DEBUG=false
APP_URL=https://<votre-domaine>
APP_TIMEZONE=Africa/Casablanca

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base de données créée depuis le panneau de l'hébergeur
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<nom_base>
DB_USERNAME=<utilisateur_base>
DB_PASSWORD=<mot_de_passe_base>

# Sauvegardes (menu Sauvegardes et tâche planifiée de 1h du matin)
MYSQLDUMP_PATH=mysqldump

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Cookies de session envoyés uniquement en HTTPS
SESSION_SECURE_COOKIE=true

# E-mails (mot de passe oublié, notifications) — ex. boîte créée chez Hostinger
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=<adresse@votre-domaine>
MAIL_PASSWORD=<mot_de_passe_de_la_boite>
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=<adresse@votre-domaine>
MAIL_FROM_NAME="${APP_NAME}"

# Notifications aux parents aussi par e-mail (une fois MAIL_* vérifié)
PARENTS_NOTIFICATIONS_MAIL=false
# Annonces importantes et urgentes aussi par e-mail
ANNONCES_MAIL=false
